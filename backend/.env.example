# OmniRoute LLM Gateway (e.g. http://localhost:20128/v1)
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=your_omniroute_api_key_here
OMNIROUTE_MODEL=oc/hy3-free

# LiveKit Credentials (get from https://cloud.livekit.io)
LIVEKIT_URL=wss://your-project-xxxxx.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sarvam AI STT & TTS (get from https://dashboard.sarvam.ai)
SARVAM_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxx
SARVAM_SPEAKER=priya
SARVAM_MODEL=bulbul:v3
SARVAM_LANGUAGE_CODE=en-IN

# OpenAI API Key (get from https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxx

# NewsAPI Key (get from https://newsapi.org/register)
NEWSAPI_KEY=your_newsapi_key_here

# Tavily API Key for web search (get from https://tavily.com)
TAVILY_API_KEY=your_tavily_api_key_here

# Firecrawl API Key for web scraping (get from https://www.firecrawl.dev)
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# GitHub Personal Access Token (get from https://github.com/settings/tokens)
GITHUB_TOKEN=your_github_token_here